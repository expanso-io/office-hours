# Pipeline Office Hours #00004 - all three demos from one place.
#
# `just up` deploys and updates the real Expanso Cloud pipelines and brings up
# the three cockpits. That is the only "up": there is no cloud variant to
# remember and no way to think you are on Cloud when you are not. Offline
# rehearsal, which needs no credentials, is the separately named `up-offline`.
#
# Each demo keeps its own justfile and is the authority on its own lifecycle;
# this file only fans out.

set shell := ["bash", "-euo", "pipefail", "-c"]

demos := "signal-not-noise outage-buffer-replay which-site-broke"

# Pull images and prebuild so nothing downloads on air.
warm:
    for d in {{demos}}; do echo "== warm $d"; just -d demos/$d -f demos/$d/justfile warm; done

# Config-only checks; safe to run any time.
validate:
    for d in {{demos}}; do echo "== validate $d"; just -d demos/$d -f demos/$d/justfile validate; done

# Deploy and update the Cloud pipelines, then start all three cockpits in
# their baseline (pre-fix) state. Needs each demo's .env at mode 600.
# Pages: signal 127.0.0.1:19440, which-site-broke :19450, outage :19480.
up:
    for d in {{demos}}; do echo "== up $d"; just -d demos/$d -f demos/$d/justfile up; done
    just status

# Same three demos entirely on this machine, no Cloud and no credentials.
up-offline:
    for d in {{demos}}; do echo "== up-offline $d"; just -d demos/$d -f demos/$d/justfile up-offline; done
    just status

status:
    for d in {{demos}}; do echo "== $d"; just -d demos/$d -f demos/$d/justfile status; done

# Stop everything, then prove it is actually gone. teardown-check is the part
# that matters after a Cloud run: a stopped container is not a stopped job.
down:
    for d in {{demos}}; do echo "== stop $d"; just -d demos/$d -f demos/$d/justfile stop || true; done
    for d in {{demos}}; do echo "== teardown-check $d"; just -d demos/$d -f demos/$d/justfile teardown-check; done

test:
    for d in {{demos}}; do echo "== test $d"; just -d demos/$d -f demos/$d/justfile test; done

logs:
    for d in {{demos}}; do echo "== logs $d"; just -d demos/$d -f demos/$d/justfile logs; done
