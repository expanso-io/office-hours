set shell := ["bash", "-euo", "pipefail", "-c"]

warm:
    ./scripts/democtl.sh warm

validate:
    ./scripts/democtl.sh validate

start mode="cloud" variant="baseline":
    ./scripts/democtl.sh start "{{mode}}" "{{variant}}"

# Office Hours #00004: plain `up` deploys and updates the real Cloud
# pipelines and starts the cockpit. Offline rehearsal is a separate recipe.
up variant="baseline":
    ./scripts/democtl.sh start cloud "{{variant}}"

up-offline variant="baseline":
    ./scripts/democtl.sh start local "{{variant}}"

down:
    ./scripts/democtl.sh stop
    ./scripts/teardown-audit.sh

status:
    ./scripts/democtl.sh status

reset:
    ./scripts/democtl.sh reset

test:
    ./scripts/democtl.sh test

test-live:
    ./scripts/democtl.sh test-live

verify-browser:
    ./scripts/democtl.sh verify-browser

verify-cloud variant="filtered":
    ./scripts/cloudctl.sh verify "{{variant}}"

cloud-purge:
    ./scripts/cloudctl.sh purge

verify-cloud-stopped:
    ./scripts/cloudctl.sh verify-stopped

stop:
    ./scripts/democtl.sh stop

teardown-check:
    ./scripts/teardown-audit.sh

logs:
    ./scripts/democtl.sh logs
