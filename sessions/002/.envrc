# Stream-safe shell prompt for this session directory.
# Powerlevel10k hot-reloads whenever a POWERLEVEL9K_* variable changes, so
# direnv exporting these is enough; leaving the directory restores the normal
# prompt. Nothing here is a secret.

# Path: show only "sessions/002", never the full path or home directory.
export POWERLEVEL9K_SHORTEN_STRATEGY=truncate_to_last
export POWERLEVEL9K_SHORTEN_DIR_LENGTH=2

# Never show user@host in the prompt, even over SSH or as root.
export POWERLEVEL9K_CONTEXT_TEMPLATE=
export POWERLEVEL9K_CONTEXT_ROOT_TEMPLATE=
export POWERLEVEL9K_CONTEXT_REMOTE_TEMPLATE=
export POWERLEVEL9K_CONTEXT_REMOTE_SUDO_TEMPLATE=

# Terminal window / tab title. oh-my-zsh defaults to "user@host:path" and
# re-reads these every prompt, so the title stays clean while inside this dir.
export ZSH_THEME_TERM_TITLE_IDLE='Expanso Office Hours'
export ZSH_THEME_TERM_TAB_TITLE_IDLE='Office Hours 002'
